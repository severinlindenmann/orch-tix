#!/usr/bin/env bash
# Runs sharing.py with its pinned dependency (cryptography) through uv. Never falls back to plain python.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  if [ -x "$HOME/.local/bin/uv" ]; then
    PATH="$HOME/.local/bin:$PATH"
  else
    echo "sharing: uv is required (https://docs.astral.sh/uv/) — refusing to run without it" >&2
    exit 5
  fi
fi
exec uv run --quiet --script "$DIR/sharing.py" "$@"
